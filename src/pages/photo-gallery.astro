---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import GalleryLightbox from "@/components/react/GalleryLightbox.tsx";
import { gallerySections } from "@/mocks/photo-gallery";

const title = "Photo Gallery | M&G Security in Action — Berks County, PA";
const description =
  "Photos of M&G Security at work — Oktoberfest, arena and sporting events, school and community events, festivals, and patrols across Berks County, PA.";

// Flatten to a single list with a stable global index so the lightbox island
// (which enhances the static buttons) can map a clicked button to the right image.
const allImages = gallerySections.flatMap((section) =>
  section.images.map((img) => ({ ...img, section: section.title })),
);

// Precompute the starting global index for each section.
let running = 0;
const sectionStart: Record<string, number> = {};
for (const section of gallerySections) {
  sectionStart[section.id] = running;
  running += section.images.length;
}
---
<BaseLayout title={title} description={description} canonical="/photo-gallery">
  <main>
    {/* Hero */}
    <section class="relative bg-secondary-500 pt-[140px] pb-20 px-6 md:px-10">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_oklch(var(--primary-500)/0.08),_transparent_50%)]"></div>
      <div class="relative z-10 max-w-4xl">
        <SectionLabel tone="dark">Gallery</SectionLabel>
        <h1 class="mt-5 font-heading text-4xl md:text-5xl lg:text-6xl text-foreground-50">
          M&amp;G Security <span class="text-primary-500">in Action</span>
        </h1>
        <p class="mt-6 max-w-2xl text-foreground-400 text-base leading-relaxed">
          Photos from events, construction sites, and venues across Berks County where M&amp;G Security has provided professional protection.
        </p>
      </div>
    </section>

    {/* Theme quick nav */}
    <div class="sticky top-20 z-40 bg-background-50/95 backdrop-blur border-b border-background-200">
      <div class="w-full px-6 md:px-10 py-3 flex items-center gap-2 overflow-x-auto">
        {gallerySections.map((section) => (
          <a
            href={`#${section.id}`}
            class="flex-shrink-0 px-4 py-2 bg-secondary-100 text-secondary-900 font-label text-xs uppercase tracking-[0.05em] whitespace-nowrap hover:bg-secondary-500 hover:text-foreground-50 transition-colors cursor-pointer"
          >
            {section.title}
          </a>
        ))}
      </div>
    </div>

    {/* Themed sections */}
    <div class="px-6 md:px-10 py-20 md:py-28 flex flex-col gap-20 md:gap-24">
      {gallerySections.map((section) => (
        <section id={section.id} class="scroll-mt-32">
          <div>
            <div class="flex items-end justify-between gap-6 flex-wrap">
              <div class="max-w-2xl">
                <h2 class="font-heading text-2xl md:text-3xl text-foreground-950">{section.title}</h2>
                <p class="mt-3 text-foreground-600 text-sm md:text-base leading-relaxed">{section.description}</p>
              </div>
              <span class="text-foreground-400 text-xs font-label uppercase tracking-[0.1em] whitespace-nowrap">
                {section.images.length} photos
              </span>
            </div>
          </div>

          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {section.images.map((img, i) => (
              <button
                type="button"
                data-gallery-open={sectionStart[section.id] + i}
                class="group relative overflow-hidden aspect-[4/3] text-left cursor-pointer bg-background-100"
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  title={img.alt}
                  loading="lazy"
                  class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-secondary-500/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="absolute bottom-0 left-0 right-0 p-4 translate-y-3 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                  <p class="text-xs font-medium text-foreground-50">{img.caption}</p>
                </div>
              </button>
            ))}
          </div>
        </section>
      ))}
    </div>

    <GalleryLightbox client:load images={allImages} />
  </main>
</BaseLayout>
