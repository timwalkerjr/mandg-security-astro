---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import CtaBand from "@/components/CtaBand.astro";
import { articleSchema } from "@/lib/seo";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  author?: string;
  slug: string;
  jsonLd?: object; // app-supplied Article schema override (twc-publish)
}

const { title, description, pubDate, updatedDate, heroImage, author, slug, jsonLd } =
  Astro.props;
const path = `/articles/${slug}`;

// App-owns-JSON-LD: use the frontmatter override if present, else build it.
const schema =
  jsonLd ??
  articleSchema({ title, description, path, pubDate, updatedDate, author, image: heroImage });

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`${title} | M&G Security`} description={description} canonical={path} image={heroImage} jsonLd={schema}>
  <main>
    <article>
      {/* Hero — matches the service-detail layout */}
      <section class="relative bg-secondary-500 pt-[140px] pb-20 px-6 md:px-10">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_oklch(var(--primary-500)/0.08),_transparent_50%)]"></div>
        <div class="relative z-10 max-w-4xl">
          <SectionLabel tone="dark">Articles</SectionLabel>
          <h1 class="mt-5 font-heading text-4xl md:text-5xl lg:text-6xl text-foreground-50">{title}</h1>
          <p class="mt-5 flex items-center gap-3 text-foreground-400 text-sm">
            <span>{author}</span>
            <span class="w-1 h-1 bg-primary-500"></span>
            <time datetime={pubDate.toISOString()}>{dateFmt(pubDate)}</time>
          </p>
        </div>
      </section>

      {/* Breadcrumbs */}
      <div class="border-b border-background-200 bg-background-50 px-6 md:px-10 py-4">
        <div class="w-full flex items-center gap-2 text-xs font-label uppercase tracking-[0.1em] text-foreground-600">
          <a href="/" class="hover:text-primary-500 transition-colors cursor-pointer">Home</a>
          <span>/</span>
          <a href="/articles" class="hover:text-primary-500 transition-colors cursor-pointer">Articles</a>
          <span>/</span>
          <span class="text-foreground-950">{title}</span>
        </div>
      </div>

      {/* Content — 8 / 4 two-column with sidebar */}
      <section class="py-20 md:py-28 px-6 md:px-10">
        <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
          {/* Main content */}
          <div class="lg:col-span-8">
            {heroImage && (
              <img src={heroImage} alt={title} class="w-full aspect-[16/9] object-cover mb-10" />
            )}
            <div class="prose-mg text-foreground-700 leading-relaxed">
              <slot />
            </div>
          </div>

          {/* Sidebar */}
          <div class="lg:col-span-4">
            <div class="border border-background-200 bg-background-50 p-6">
              <h2 class="font-heading text-lg text-foreground-950">Get a Free Security Quote</h2>
              <p class="mt-2 text-sm text-foreground-600 leading-relaxed">
                Contact M&amp;G Security today for a tailored security assessment and quote for your next event or property.
              </p>
              <div class="mt-5 flex flex-col gap-3">
                <a
                  href="tel:+14848248631"
                  class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary-500 text-foreground-950 font-label text-xs uppercase tracking-[0.1em] hover:bg-primary-600 transition-colors whitespace-nowrap cursor-pointer"
                >
                  <i class="ri-phone-line"></i>
                  Call (484) 824-8631
                </a>
                <a
                  href="/contact-us"
                  class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border border-background-300 text-foreground-950 font-label text-xs uppercase tracking-[0.1em] hover:bg-background-100 transition-colors whitespace-nowrap cursor-pointer"
                >
                  <i class="ri-mail-line"></i>
                  Request a Quote
                </a>
              </div>
            </div>

            <div class="mt-5 border border-background-200 bg-background-50 p-6">
              <h2 class="font-heading text-sm text-foreground-950 uppercase tracking-[0.05em]">Why Choose M&amp;G</h2>
              <ul class="mt-4 space-y-3">
                <li class="flex items-start gap-2.5 text-sm text-foreground-600">
                  <i class="ri-shield-check-line text-primary-500 mt-0.5"></i>
                  Active &amp; retired law enforcement officers
                </li>
                <li class="flex items-start gap-2.5 text-sm text-foreground-600">
                  <i class="ri-shield-check-line text-primary-500 mt-0.5"></i>
                  Founded in 1997 by a former police officer
                </li>
                <li class="flex items-start gap-2.5 text-sm text-foreground-600">
                  <i class="ri-shield-check-line text-primary-500 mt-0.5"></i>
                  60+ years combined law enforcement experience
                </li>
                <li class="flex items-start gap-2.5 text-sm text-foreground-600">
                  <i class="ri-shield-check-line text-primary-500 mt-0.5"></i>
                  24/7 availability for emergencies
                </li>
              </ul>
            </div>

            <div class="mt-5">
              <a href="/articles" class="inline-flex items-center gap-1.5 text-xs font-label uppercase tracking-[0.1em] text-primary-500 hover:text-primary-600 transition-colors cursor-pointer">
                <i class="ri-arrow-left-line"></i>
                All Articles
              </a>
            </div>
          </div>
        </div>
      </section>

      <CtaBand
        heading="Need Security for Your Next Event?"
        text="Contact us today for a tailored security assessment and quote. Our team is ready to protect your people, property, and peace of mind."
      >
        <a
          href="tel:+14848248631"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary-500 text-foreground-950 font-label text-xs uppercase tracking-[0.1em] hover:bg-primary-600 transition-colors whitespace-nowrap cursor-pointer"
        >
          <i class="ri-phone-line"></i>
          Call (484) 824-8631
        </a>
        <a
          href="/contact-us"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-foreground-50/30 text-foreground-50 font-label text-xs uppercase tracking-[0.1em] hover:bg-foreground-50/10 transition-colors whitespace-nowrap cursor-pointer"
        >
          Request a Quote
        </a>
      </CtaBand>
    </article>
  </main>
</BaseLayout>

<style is:global>
  /* Minimal prose styling for MDX article bodies. */
  .prose-mg > * + * { margin-top: 1.25rem; }
  .prose-mg h2 { font-family: var(--font-heading); text-transform: uppercase; letter-spacing: -0.02em; font-weight: 700; font-size: 1.5rem; line-height: 1.2; margin-top: 2.5rem; color: oklch(var(--foreground-950)); }
  .prose-mg h3 { font-family: var(--font-heading); text-transform: uppercase; letter-spacing: -0.02em; font-weight: 700; font-size: 1.15rem; margin-top: 2rem; color: oklch(var(--foreground-950)); }
  .prose-mg p { font-size: 0.975rem; }
  .prose-mg a { color: oklch(var(--primary-600)); text-decoration: underline; }
  .prose-mg a:hover { color: oklch(var(--primary-500)); }
  .prose-mg ul { list-style: disc; padding-left: 1.5rem; }
  .prose-mg ol { list-style: decimal; padding-left: 1.5rem; }
  .prose-mg li { margin-top: 0.5rem; font-size: 0.975rem; }
  .prose-mg strong { color: oklch(var(--foreground-950)); font-weight: 700; }
  .prose-mg blockquote { border-left: 3px solid oklch(var(--primary-500)); padding-left: 1rem; color: oklch(var(--foreground-600)); }
</style>
