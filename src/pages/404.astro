---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Page Not Found | M&G Security";
---
<BaseLayout title={title} description="The page you are looking for does not exist." noindex={true}>
  <main class="relative flex flex-col items-center justify-center min-h-screen text-center px-4 bg-background-50">
    <span class="absolute bottom-0 text-9xl md:text-[12rem] font-black text-background-200 select-none pointer-events-none z-0 font-heading">404</span>
    <div class="relative z-10">
      <h1 class="font-heading text-xl md:text-2xl mt-6 text-foreground-950">Page Not Found</h1>
      <p class="mt-4 text-lg md:text-xl text-foreground-600">The page you are looking for does not exist.</p>
      <a
        href="/"
        class="mt-8 inline-flex items-center gap-2 px-8 py-4 bg-primary-500 text-foreground-950 font-label text-xs uppercase tracking-[0.1em] hover:bg-primary-600 transition-colors cursor-pointer"
      >
        <i class="ri-home-line"></i>
        Back to Home
      </a>
    </div>
  </main>
</BaseLayout>
