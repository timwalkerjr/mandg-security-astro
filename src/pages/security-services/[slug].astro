---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import CtaBand from "@/components/CtaBand.astro";
import { serviceDetails } from "@/data/services";
import { serviceSchema, breadcrumbSchema } from "@/lib/seo";

export function getStaticPaths() {
  return serviceDetails.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const path = `/security-services/${service.slug}`;
const jsonLd = [
  serviceSchema({ name: service.title, description: service.metaDescription, path }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Security Services", path: "/security-services" },
    { name: service.title, path },
  ]),
];
---
<BaseLayout title={service.metaTitle} description={service.metaDescription} canonical={path} jsonLd={jsonLd}>
  <main>
    {/* Hero */}
    <section class="relative bg-secondary-500 pt-[140px] pb-20 px-6 md:px-10">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_oklch(var(--primary-500)/0.08),_transparent_50%)]"></div>
      <div class="relative z-10 max-w-4xl">
        <SectionLabel tone="dark">Security Services</SectionLabel>
        <h1 class="mt-5 font-heading text-4xl md:text-5xl lg:text-6xl text-foreground-50">{service.title}</h1>
        <p class="mt-4 text-xl md:text-2xl text-primary-500 font-heading">{service.tagline}</p>
      </div>
    </section>

    {/* Breadcrumbs */}
    <div class="border-b border-background-200 bg-background-50 px-6 md:px-10 py-4">
      <div class="w-full flex items-center gap-2 text-xs font-label uppercase tracking-[0.1em] text-foreground-600">
        <a href="/" class="hover:text-primary-500 transition-colors cursor-pointer">Home</a>
        <span>/</span>
        <a href="/security-services" class="hover:text-primary-500 transition-colors cursor-pointer">Security Services</a>
        <span>/</span>
        <span class="text-foreground-950">{service.title}</span>
      </div>
    </div>

    {/* Content */}
    <section class="py-20 md:py-28 px-6 md:px-10">
      <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-8">
          <div class="w-14 h-14 flex items-center justify-center bg-primary-100 text-primary-500">
            <i class={`${service.icon} text-3xl`}></i>
          </div>

          <div class="mt-8 space-y-5">
            {service.paragraphs.map((p) => (
              <p class="text-foreground-700 text-base leading-relaxed">{p}</p>
            ))}
          </div>

          <div class="mt-12">
            <h2 class="font-heading text-xl md:text-2xl text-foreground-950">What M&amp;G Provides</h2>
            <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
              {service.features.map((f) => (
                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 flex items-center justify-center mt-0.5 shrink-0">
                    <i class="ri-checkbox-circle-fill text-primary-500"></i>
                  </div>
                  <span class="text-sm text-foreground-700 leading-relaxed">{f}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        {/* Sidebar */}
        <div class="lg:col-span-4">
          <div class="border border-background-200 bg-background-50 p-6">
            <h3 class="font-heading text-lg text-foreground-950">Request This Service</h3>
            <p class="mt-2 text-sm text-foreground-600 leading-relaxed">
              Contact M&amp;G Security today for a tailored security assessment and quote for your {service.title.toLowerCase()} needs.
            </p>
            <div class="mt-5 flex flex-col gap-3">
              <a
                href="tel:+14848248631"
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary-500 text-foreground-950 font-label text-xs uppercase tracking-[0.1em] hover:bg-primary-600 transition-colors whitespace-nowrap cursor-pointer"
              >
                <i class="ri-phone-line"></i>
                Call (484) 824-8631
              </a>
              <a
                href="/contact-us"
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border border-background-300 text-foreground-950 font-label text-xs uppercase tracking-[0.1em] hover:bg-background-100 transition-colors whitespace-nowrap cursor-pointer"
              >
                <i class="ri-mail-line"></i>
                Request a Quote
              </a>
            </div>
          </div>

          <div class="mt-5 border border-background-200 bg-background-50 p-6">
            <h3 class="font-heading text-sm text-foreground-950 uppercase tracking-[0.05em]">Why Choose M&amp;G</h3>
            <ul class="mt-4 space-y-3">
              <li class="flex items-start gap-2.5 text-sm text-foreground-600">
                <i class="ri-shield-check-line text-primary-500 mt-0.5"></i>
                Active &amp; retired law enforcement officers
              </li>
              <li class="flex items-start gap-2.5 text-sm text-foreground-600">
                <i class="ri-shield-check-line text-primary-500 mt-0.5"></i>
                Founded in 1997 by a former police officer
              </li>
              <li class="flex items-start gap-2.5 text-sm text-foreground-600">
                <i class="ri-shield-check-line text-primary-500 mt-0.5"></i>
                60+ years combined law enforcement experience
              </li>
              <li class="flex items-start gap-2.5 text-sm text-foreground-600">
                <i class="ri-shield-check-line text-primary-500 mt-0.5"></i>
                24/7 availability for emergencies
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <CtaBand
      heading={`Need ${service.title}?`}
      text="Contact us today for a tailored security assessment and quote. Our team is ready to protect your people, property, and peace of mind."
    >
      <a
        href="tel:+14848248631"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary-500 text-foreground-950 font-label text-xs uppercase tracking-[0.1em] hover:bg-primary-600 transition-colors whitespace-nowrap cursor-pointer"
      >
        <i class="ri-phone-line"></i>
        Call (484) 824-8631
      </a>
      <a
        href="/contact-us"
        class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-foreground-50/30 text-foreground-50 font-label text-xs uppercase tracking-[0.1em] hover:bg-foreground-50/10 transition-colors whitespace-nowrap cursor-pointer"
      >
        Request a Quote
      </a>
    </CtaBand>
  </main>
</BaseLayout>
