---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import EmploymentForm from "@/components/react/EmploymentForm.tsx";
import { localBusinessSchema } from "@/lib/seo";

const title = "Employment Opportunities | M&G Security Careers — Berks County, PA";
const description =
  "Join the M&G Security team. We're hiring qualified security guards across Berks County, PA — current and retired law enforcement officers encouraged to apply. Equal opportunity employer.";

const steps = [
  { step: "01", title: "Download Application", desc: "Download our official M&G Security employment application form. Print and complete all required fields.", icon: "ri-download-line" },
  { step: "02", title: "Complete & Attach Documents", desc: "Fill out the application thoroughly and attach any relevant certifications, resumes, or law enforcement credentials.", icon: "ri-file-list-line" },
  { step: "03", title: "Submit Application", desc: "Return your completed application to our office or submit it via the form below. Our hiring manager will contact you within 5 business days.", icon: "ri-send-plane-line" },
];
---
<BaseLayout title={title} description={description} canonical="/employment-opportunities" jsonLd={localBusinessSchema()}>
  <main>
    {/* Hero */}
    <section class="relative bg-secondary-500 pt-[140px] pb-20 px-6 md:px-10">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_oklch(var(--primary-500)/0.08),_transparent_50%)]"></div>
      <div class="relative z-10 max-w-4xl">
        <SectionLabel tone="dark">Careers</SectionLabel>
        <h1 class="mt-5 font-heading text-4xl md:text-5xl lg:text-6xl text-foreground-50">
          Join the <span class="text-primary-500">M&amp;G Team</span>
        </h1>
        <p class="mt-6 max-w-2xl text-foreground-400 text-base leading-relaxed">
          M&amp;G Security is always looking for qualified security guards to join our team. If you are a current or retired law enforcement officer, we want to hear from you.
        </p>
      </div>
    </section>

    {/* EEO Statement */}
    <section class="py-16 md:py-24 px-6 md:px-10">
      <div class="w-full max-w-3xl mx-auto text-center">
        <h2 class="font-heading text-2xl md:text-3xl text-foreground-950">Equal Employment Opportunity</h2>
        <p class="mt-5 text-foreground-600 text-sm md:text-base leading-relaxed">
          M&amp;G Security is an equal opportunity employer. We do not discriminate on the basis of race, color, religion, sex, national origin, age, disability, or any other protected status. We welcome applications from all qualified individuals, including current and retired law enforcement officers.
        </p>
      </div>
    </section>

    {/* Application Steps */}
    <section class="bg-background-100 py-24 md:py-32 px-6 md:px-10">
      <div class="w-full">
        <div class="text-center mb-14">
          <SectionLabel>How to Apply</SectionLabel>
          <h2 class="mt-5 font-heading text-3xl md:text-4xl text-foreground-950">3-Step Application Process</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          {steps.map((item) => (
            <div class="bg-background-50 border border-background-200 p-8 text-center">
              <div class="w-14 h-14 mx-auto flex items-center justify-center bg-primary-100 text-primary-500">
                <i class={`${item.icon} text-2xl`}></i>
              </div>
              <div class="mt-4 font-label text-xs text-primary-500 uppercase tracking-[0.1em]">{item.step}</div>
              <h3 class="mt-3 font-heading text-lg text-foreground-950">{item.title}</h3>
              <p class="mt-3 text-sm text-foreground-600 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Submit Application */}
    <section class="py-16 md:py-24 px-6 md:px-10">
      <div class="w-full max-w-3xl mx-auto">
        <div class="bg-background-100 border border-background-200 p-8 md:p-12">
          <h2 class="font-heading text-xl text-foreground-950 text-center">Submit Your Application</h2>
          <p class="mt-3 text-sm text-foreground-600 text-center">
            Send your completed application and supporting documents to us. We recommend including your resume and any law enforcement credentials.
          </p>

          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="text-center sm:text-left">
              <div class="font-label text-xs uppercase tracking-[0.1em] text-foreground-500 mb-2">By Mail</div>
              <p class="text-sm text-foreground-700">
                M&amp;G Security<br />
                P.O. Box 6255<br />
                Wyomissing, PA 19610
              </p>
            </div>
            <div class="text-center sm:text-left">
              <div class="font-label text-xs uppercase tracking-[0.1em] text-foreground-500 mb-2">By Phone</div>
              <a href="tel:+14848248631" class="text-sm text-foreground-700 hover:text-primary-500 transition-colors cursor-pointer font-medium">
                (484) 824-8631
              </a>
              <p class="text-xs text-foreground-500 mt-1">Ask for the hiring manager</p>
            </div>
          </div>

          <div class="mt-8 pt-8 border-t border-background-200">
            <EmploymentForm client:load />
          </div>
        </div>
      </div>
    </section>

    {/* CTA Band */}
    <section class="relative bg-secondary-500 py-16 md:py-20 px-6 md:px-10 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_75%_50%,_oklch(var(--primary-500)/0.10),_transparent_60%)]"></div>
      <div class="relative z-10 w-full flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="text-center md:text-left">
          <h2 class="font-heading text-3xl md:text-4xl text-foreground-50">Have Questions About the Job?</h2>
          <p class="mt-3 max-w-xl text-foreground-400 text-sm md:text-base leading-relaxed">
            Call us directly to speak with our hiring manager about open positions and requirements.
          </p>
        </div>
        <a
          href="tel:+14848248631"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary-500 text-foreground-950 font-label text-xs uppercase tracking-[0.1em] hover:bg-primary-600 transition-colors whitespace-nowrap cursor-pointer"
        >
          <i class="ri-phone-line"></i>
          Call (484) 824-8631
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
