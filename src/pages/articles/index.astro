---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import { getCollection } from "astro:content";

const title = "Articles & Security Resources | M&G Security — Berks County, PA";
const description =
  "Security guidance, event-safety tips, and news from the M&G Security team — professional security services across Berks County, PA since 1997.";

const posts = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={title} description={description} canonical="/articles">
  <main>
    {/* Hero */}
    <section class="relative bg-secondary-500 pt-[140px] pb-20 px-6 md:px-10">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_oklch(var(--primary-500)/0.08),_transparent_50%)]"></div>
      <div class="relative z-10 max-w-4xl">
        <SectionLabel tone="dark">Articles</SectionLabel>
        <h1 class="mt-5 font-heading text-4xl md:text-5xl lg:text-6xl text-foreground-50">
          News &amp; <span class="text-primary-500">Security Resources</span>
        </h1>
        <p class="mt-6 max-w-2xl text-foreground-400 text-base leading-relaxed">
          Practical security guidance, event-safety planning, and updates from the M&amp;G Security team serving Berks County, PA.
        </p>
      </div>
    </section>

    {/* List */}
    <section class="py-24 md:py-32 px-6 md:px-10">
      <div class="w-full max-w-5xl mx-auto">
        {posts.length === 0 ? (
          <p class="text-center text-foreground-600">No articles published yet. Check back soon.</p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {posts.map((post) => (
              <a href={`/articles/${post.slug}`} class="group bg-background-50 border border-background-200 overflow-hidden hover:border-primary-300 transition-colors block">
                {post.data.heroImage && (
                  <div class="aspect-[16/9] overflow-hidden bg-background-100">
                    <img src={post.data.heroImage} alt={post.data.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                  </div>
                )}
                <div class="p-6">
                  <p class="font-label text-[10px] uppercase tracking-[0.1em] text-primary-500">
                    {dateFmt(post.data.pubDate)}
                  </p>
                  <h2 class="mt-3 font-heading text-lg text-foreground-950 group-hover:text-primary-600 transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-sm text-foreground-600 leading-relaxed">{post.data.description}</p>
                  <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-label uppercase tracking-[0.1em] text-primary-500">
                    Read More
                    <i class="ri-arrow-right-line"></i>
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>
