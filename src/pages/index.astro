---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import { services, testimonials, trustSignals } from "@/mocks/home";
import { localBusinessSchema, SITE } from "@/lib/seo";

const heroStats = [
  { value: "24/7", label: "Always on call" },
  { value: "60+", label: "Years law enforcement experience" },
  { value: "1997", label: "Serving Berks County" },
];

const title = "M&G Security — Professional Security Services Berks County, PA";
---
<BaseLayout title={title} description={SITE.description} canonical="/" jsonLd={localBusinessSchema()}>
  <main>
    {/* Hero */}
    <section id="top" class="relative min-h-[80vh] w-full overflow-hidden bg-secondary-500">
      <div class="absolute inset-0">
        <img
          src="/images/mg-hero-bg-001.webp"
          alt="Professional security operations background"
          width={1920}
          height={1072}
          fetchpriority="high"
          class="w-full h-full object-cover object-top"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-secondary-500/90 via-secondary-500/80 to-secondary-500/95"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_oklch(var(--primary-500)/0.12),_transparent_55%)]"></div>
      </div>

      <div class="relative z-10 w-full px-6 md:px-10 pt-[140px] md:pt-[160px] pb-20">
        <div class="max-w-4xl mx-auto text-center">
          <div class="text-foreground-50 animate-float-up">
            <div class="inline-flex items-center gap-2 font-label text-xs uppercase tracking-[0.05em] text-foreground-400">
              <span class="w-1.5 h-1.5 bg-primary-500 animate-pulse-dot"></span>
              <span>On call 24/7</span>
            </div>

            <h1 class="font-heading mt-6 text-4xl md:text-5xl lg:text-6xl text-foreground-50">
              The Most Trusted
              <br />
              <span class="text-primary-500">Security Provider</span>
              <br />
              in Berks County
            </h1>

            <p class="mt-7 max-w-2xl mx-auto text-base text-foreground-400 leading-relaxed">
              M&amp;G Security is a Pennsylvania-based security company founded in 1997 by former law enforcement officers.
              Our active and retired police staff bring over 60 years of combined law enforcement experience to every assignment.
            </p>

            <div class="mt-9 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">
              <a
                href="tel:+14848248631"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary-500 text-foreground-950 font-label text-xs uppercase tracking-[0.1em] hover:bg-primary-600 transition-colors whitespace-nowrap cursor-pointer"
              >
                <i class="ri-phone-line"></i>
                (484) 824-8631
              </a>
              <a
                href="/contact-us"
                class="inline-flex items-center justify-center gap-2 px-8 py-4 text-foreground-400 hover:text-foreground-50 font-label text-xs uppercase tracking-[0.1em] transition-colors whitespace-nowrap cursor-pointer border border-foreground-700 hover:border-primary-500"
              >
                <i class="ri-mail-line text-primary-500"></i>
                Request a Quote
              </a>
            </div>

            <div class="mt-14 flex flex-wrap justify-center gap-x-12 gap-y-6">
              {heroStats.map((s) => (
                <div class="text-center">
                  <div class="font-heading text-3xl md:text-4xl text-primary-500">{s.value}</div>
                  <div class="mt-1 font-label text-xs uppercase tracking-[0.2em] text-foreground-400">{s.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Services */}
    <section id="services" class="bg-background-50 py-24 md:py-32 px-6 md:px-10">
      <div class="w-full">
        <div class="flex flex-col items-center text-center">
          <SectionLabel>What We Do</SectionLabel>
          <h2 class="mt-5 font-heading text-4xl md:text-5xl text-foreground-950">
            Professional Security Services
          </h2>
          <p class="mt-4 max-w-xl text-foreground-600 text-sm md:text-base leading-relaxed">
            From crowd control to site security — one team with real law enforcement experience, one accountable contract.
          </p>
        </div>

        <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {services.map((s) => (
            <a
              href={`/security-services/${s.slug}`}
              class="group relative bg-background-50 border border-background-200 p-7 overflow-hidden transition-all duration-500 hover:-translate-y-1 hover:border-primary-300 block"
            >
              <span class="absolute inset-x-0 bottom-0 h-0 bg-primary-500 transition-all duration-500 group-hover:h-full -z-0"></span>
              <div class="relative z-10 transition-colors duration-500 group-hover:text-foreground-50">
                <div class="w-12 h-12 flex items-center justify-center bg-primary-100 text-primary-500 group-hover:bg-foreground-50/15 group-hover:text-foreground-50 transition-colors duration-500">
                  <i class={`${s.icon} text-2xl`}></i>
                </div>
                <h3 class="mt-5 font-heading text-lg text-foreground-950 group-hover:text-foreground-50 transition-colors duration-500">
                  {s.title}
                </h3>
                <p class="mt-2 text-sm text-foreground-600 leading-relaxed group-hover:text-foreground-50/85 transition-colors duration-500">
                  {s.desc}
                </p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-label uppercase tracking-[0.1em] text-primary-500 group-hover:text-foreground-950 transition-colors duration-500">
                  Learn More
                  <i class="ri-arrow-right-line"></i>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* About / Stats */}
    <section class="bg-secondary-500 py-24 md:py-32 px-6 md:px-10">
      <div class="w-full">
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center">
          <div class="w-full lg:w-1/2">
            <div class="relative overflow-hidden aspect-[4/3]">
              <img src="/images/mg-about-001.webp" alt="M&G Security professional guard" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-secondary-500/60 to-transparent"></div>
            </div>
          </div>

          <div class="w-full lg:w-1/2">
            <SectionLabel tone="dark">Our Story</SectionLabel>
            <h2 class="mt-5 font-heading text-3xl md:text-4xl text-foreground-50">
              Founded by Law Enforcement, Built on Trust
            </h2>
            <p class="mt-4 text-foreground-400 text-sm md:text-base leading-relaxed">
              M&amp;G Security was founded in 1997 by former Reading Police Sergeant <strong class="text-foreground-200">Mark N. Pellicciotti</strong> and retired Pennsylvania State Trooper <strong class="text-foreground-200">Anthony DiGuglielmo</strong>.
            </p>
            <p class="mt-4 text-foreground-400 text-sm md:text-base leading-relaxed">
              Our staff consists of active and retired law enforcement personnel with over <span class="text-primary-500 font-semibold">60 years of combined experience</span>. We have been proudly serving Berks County and surrounding areas for over 27 years.
            </p>
            <p class="mt-4 text-foreground-400 text-sm md:text-base leading-relaxed">
              From the Santander Arena to local construction sites, high school proms to corporate offices, we bring the discipline, training, and professionalism of law enforcement to every assignment.
            </p>

            <div class="mt-8 grid grid-cols-3 gap-6">
              <div>
                <div class="font-heading text-2xl md:text-3xl text-primary-500">1997</div>
                <div class="mt-1 font-label text-xs uppercase tracking-[0.2em] text-foreground-600">Founded</div>
              </div>
              <div>
                <div class="font-heading text-2xl md:text-3xl text-primary-500">60+</div>
                <div class="mt-1 font-label text-xs uppercase tracking-[0.2em] text-foreground-600">Years LEO Exp.</div>
              </div>
              <div>
                <div class="font-heading text-2xl md:text-3xl text-primary-500">27+</div>
                <div class="mt-1 font-label text-xs uppercase tracking-[0.2em] text-foreground-600">Years in Berks</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Testimonials */}
    <section class="bg-background-100 py-24 md:py-32 px-6 md:px-10">
      <div class="w-full">
        <div class="flex flex-col items-center text-center">
          <SectionLabel>Testimonials</SectionLabel>
          <h2 class="mt-5 font-heading text-4xl md:text-5xl text-foreground-950">
            What Our Clients Say
          </h2>
          <p class="mt-4 max-w-xl text-foreground-600 text-sm md:text-base leading-relaxed">
            Real feedback from the businesses, schools, and organizations we protect across Berks County.
          </p>
        </div>

        <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-5">
          {testimonials.map((t) => (
            <div class="bg-background-50 border border-background-200 p-7 flex flex-col">
              <div class="flex items-center gap-4">
                <img src={t.img} alt={t.name} class="w-12 h-12 object-cover" />
                <div>
                  <p class="font-heading text-sm text-foreground-950">{t.name}</p>
                  <p class="text-xs text-foreground-500">{t.role}</p>
                </div>
              </div>
              <p class="mt-5 text-sm text-foreground-700 leading-relaxed flex-1">
                &ldquo;{t.quote}&rdquo;
              </p>
              <div class="mt-5 flex gap-1">
                {[1, 2, 3, 4, 5].map(() => (
                  <i class="ri-star-fill text-primary-500 text-sm"></i>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Partners marquee (CSS-only animation, no JS) */}
    <section class="bg-secondary-500 py-10 md:py-12 overflow-hidden border-y border-foreground-800">
      <div class="w-full px-6 md:px-10 mb-6">
        <p class="text-center font-label text-sm uppercase tracking-[0.1em] text-foreground-400">
          Trusted by leading organizations across Berks County
        </p>
      </div>

      <div class="relative flex overflow-hidden">
        <div class="flex animate-marquee whitespace-nowrap">
          {[...trustSignals, ...trustSignals].map((name) => (
            <span class="mx-10 flex items-center gap-4 text-foreground-400 text-xl font-semibold">
              <i class="ri-shield-check-line text-primary-500 text-3xl"></i>
              {name}
            </span>
          ))}
        </div>
        <div class="flex animate-marquee whitespace-nowrap" aria-hidden="true">
          {[...trustSignals, ...trustSignals].map((name) => (
            <span class="mx-10 flex items-center gap-4 text-foreground-400 text-xl font-semibold">
              <i class="ri-shield-check-line text-primary-500 text-3xl"></i>
              {name}
            </span>
          ))}
        </div>
      </div>
    </section>

    {/* Hiring CTA */}
    <section class="relative bg-secondary-500 py-16 md:py-20 px-6 md:px-10 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_75%_50%,_oklch(var(--primary-500)/0.10),_transparent_60%)]"></div>
      <div class="relative z-10 w-full flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="text-center md:text-left">
          <h2 class="font-heading text-3xl md:text-4xl text-foreground-50">We Are Hiring</h2>
          <p class="mt-3 max-w-xl text-foreground-400 text-sm md:text-base leading-relaxed">
            M&amp;G Security is always looking for qualified security guards to join our team. If you are a current or retired law enforcement officer, we want to hear from you.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="/employment-opportunities"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary-500 text-foreground-950 font-label text-xs uppercase tracking-[0.1em] hover:bg-primary-600 transition-colors whitespace-nowrap cursor-pointer"
          >
            Apply Now
            <i class="ri-arrow-right-line"></i>
          </a>
          <a
            href="/contact-us"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-foreground-50/30 text-foreground-50 font-label text-xs uppercase tracking-[0.1em] hover:bg-foreground-50/10 transition-colors whitespace-nowrap cursor-pointer"
          >
            Contact Us
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
